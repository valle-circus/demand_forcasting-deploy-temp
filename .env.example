# Optional Snowflake discovery helper. Copy to .env or set these in your shell;
# never commit real values.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# Python API / Render. SUPABASE_SECRET_KEY is server-only and must never use a
# VITE_ prefix or be copied into the browser application's environment.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=
