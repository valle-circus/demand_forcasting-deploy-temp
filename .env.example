# Optional Snowflake discovery helper. Copy to .env or set these in your shell;
# never commit real values.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# Python API / Render. Copy these values to the repository-root .env for local
# API development and configure them on the Render service for deployment.
# CORS_ORIGINS must contain exact, comma-separated browser origins; do not use *.
# SUPABASE_SECRET_KEY is server-only and must never use a VITE_ prefix or be
# copied into the browser application's environment.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=10
MAX_UPLOAD_BYTES=26214400
MAX_PO_FILES=100

# React/Vite UI / Vercel. For local UI development, copy these entries to
# apps/web/.env.local; Vite does not read the repository-root .env when started
# from apps/web. Configure the same names in the Vercel project for deployments.
# Every VITE_ value is embedded in the browser build and must be browser-safe.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
