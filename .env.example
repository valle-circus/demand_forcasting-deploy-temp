# Optional Snowflake discovery helper. Copy to .env or set these in your shell;
# never commit real values.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# Python API / Render. Copy these values to the repository-root .env for local
# API development and configure them on the Render service for deployment.
# CORS_ORIGINS must contain exact, comma-separated browser origins; do not use *.
# SUPABASE_SECRET_KEY is server-only and must never use a VITE_ prefix or be
# copied into the browser application's environment.
# ALLOWED_EMAIL_DOMAINS gates self-service sign-up. Comma-separated exact
# domains; blank and wildcard values are refused rather than read as "allow
# everyone", because every account this API accepts is a full maintainer. Keep
# it in step with VITE_ALLOWED_EMAIL_DOMAINS and with the domain list in
# supabase/migrations/202609030006_signup_email_domain_gate.sql.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=circuskitchens.com
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=10
MAX_UPLOAD_BYTES=26214400
MAX_PO_FILES=100

# React/Vite UI / Vercel. For local UI development, copy these entries to
# apps/web/.env.local; Vite does not read the repository-root .env when started
# from apps/web. Configure the same names in the Vercel project for deployments.
# Every VITE_ value is embedded in the browser build and must be browser-safe.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Shown in the sign-up form so a rejected address is explained before the round
# trip. This copy is a hint, not a gate; the enforced copies are the migration
# trigger and ALLOWED_EMAIL_DOMAINS above.
VITE_ALLOWED_EMAIL_DOMAINS=circuskitchens.com
